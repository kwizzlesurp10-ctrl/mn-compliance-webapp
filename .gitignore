# Only track the app, root docs, and CI. (Repo root is your home directory.)
/*
!/.gitignore
!/README.md
!/.github/
!/.github/**
!/mn-compliance-webapp/
!/mn-compliance-webapp/**

# Next / Node (inside app)
mn-compliance-webapp/node_modules/
mn-compliance-webapp/.next/
mn-compliance-webapp/out/
mn-compliance-webapp/coverage/
mn-compliance-webapp/.turbo/
mn-compliance-webapp/.vercel/
mn-compliance-webapp/*.tsbuildinfo

# App env
mn-compliance-webapp/.env
mn-compliance-webapp/.env*.local
