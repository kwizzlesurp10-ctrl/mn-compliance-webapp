# Only track the app, root docs, and CI. (Repo root is your home directory.)
/*
!/.gitignore
!/README.md
!/.github/
!/.github/**
!/webapp/
!/webapp/**

# Next / Node (inside app)
webapp/node_modules/
webapp/.next/
webapp/out/
webapp/coverage/
webapp/.turbo/
webapp/.vercel/
webapp/*.tsbuildinfo

# App env
webapp/.env
webapp/.env*.local
